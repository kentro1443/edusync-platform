{
  "name": "edusync-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test && playwright test --config=playwright.dev-mode.config.ts",
    "verify": "node scripts/verify.mjs",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "account:rotate-production-dev-password": "NODE_OPTIONS=--conditions=react-server tsx scripts/rotate-production-dev-password.ts",
    "db:test-fixtures:clean": "tsx scripts/cleanup-test-fixtures.ts",
    "outbox:process": "NODE_OPTIONS=--conditions=react-server tsx scripts/process-outbox.ts",
    "maintenance:cleanup": "NODE_OPTIONS=--conditions=react-server tsx scripts/cleanup-retention.ts",
    "workflows:escalate": "NODE_OPTIONS=--conditions=react-server tsx scripts/process-workflow-escalations.ts",
    "calendar:remind": "NODE_OPTIONS=--conditions=react-server tsx scripts/process-calendar-reminders.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@vercel/blob": "^2.6.1",
    "argon2": "^0.44.0",
    "clsx": "^2.1.1",
    "next": "16.2.11",
    "next-auth": "^5.0.0-beta.30",
    "pg": "^8.16.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "prisma": "^7.9.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
