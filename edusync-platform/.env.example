# Application
NODE_ENV=development
APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-at-least-32-random-characters
# Keep false unless a production developer operator is explicitly required.
ENABLE_PRODUCTION_DEV_MODE=false

# Durable and transient services
DATABASE_URL=postgresql://edusync:edusync_local@localhost:5432/edusync?schema=public
# Local Redis uses redis://. Managed Redis providers commonly use rediss://.
REDIS_URL=redis://localhost:6379

# Local file adapter. Production uses a private Vercel Blob store instead.
FILE_STORAGE_ROOT=./storage
# Added automatically by Vercel when the private Blob store is connected.
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=
EMAIL_OUTBOX_ROOT=./email-outbox
