# Application
NODE_ENV=development
APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-at-least-32-random-characters
# Keep false unless a production developer operator is explicitly required.
ENABLE_PRODUCTION_DEV_MODE=false

# Durable and transient services
DATABASE_URL=postgresql://edutech:edutech_local@localhost:5432/edutech?schema=public
# Local Redis uses redis://. Managed Redis providers commonly use rediss://.
REDIS_URL=redis://localhost:6379

# Local adapters
FILE_STORAGE_ROOT=./storage
EMAIL_OUTBOX_ROOT=./email-outbox
