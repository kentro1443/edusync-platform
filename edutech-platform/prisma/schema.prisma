generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum SchoolStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  LEFT
}

enum ParentStudentLinkStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum PlatformRole {
  PLATFORM_SUPER_ADMIN
}

enum SchoolRole {
  SCHOOL_ADMIN
  TEACHER_STAFF
  MENTOR_COUNSELOR
  STUDENT
  PARENT_GUARDIAN
  CLUB_LEADER
  APPROVER_REVIEWER
}

enum StoredFileStatus {
  PENDING
  AVAILABLE
  QUARANTINED
  DELETED
}

enum ResourceStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum ResourceVisibility {
  PRIVATE
  SCHOOL
  PUBLIC
}

enum CommentStatus {
  PUBLISHED
  HIDDEN
  DELETED
}

enum ResourceReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum EmailOutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum MentorVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum MentorAssignmentStatus {
  ACTIVE
  ENDED
}

enum AvailabilityExceptionKind {
  AVAILABLE
  UNAVAILABLE
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  WAITLISTED
  COMPLETED
  CANCELLED
  DECLINED
}

enum AppointmentWaitlistStatus {
  WAITING
  PROMOTED
  LEFT
}

enum AttendanceStatus {
  SCHEDULED
  PRESENT
  ABSENT
  EXCUSED
}

enum MentoringCaseStatus {
  OPEN
  ON_HOLD
  CLOSED
}

enum MentoringGoalStatus {
  ACTIVE
  ACHIEVED
  PAUSED
  CANCELLED
}

enum MentoringTaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum MentoringReferralStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  CLOSED
}

enum MentoringNoteVisibility {
  PRIVATE_COUNSELOR
  STUDENT_VISIBLE
  GUARDIAN_VISIBLE
  STAFF_VISIBLE
}

enum CalendarVisibility {
  PRIVATE
  SCHOOL
}

enum CalendarEventStatus {
  CONFIRMED
  CANCELLED
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum CalendarBookingStatus {
  BOOKED
  WAITLISTED
  CANCELLED
}

enum CalendarAttendanceStatus {
  SCHEDULED
  PRESENT
  ABSENT
  EXCUSED
}

enum WorkflowTemplateStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum WorkflowFieldType {
  TEXT
  TEXTAREA
  NUMBER
  DATE
  SELECT
  CHECKBOX
  FILE
}

enum WorkflowSubmissionStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  WITHDRAWN
}

enum WorkflowStepStatus {
  PENDING
  ACTIVE
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  SKIPPED
}

enum WorkflowDecisionType {
  APPROVE
  REJECT
  REQUEST_CHANGES
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  email              String
  normalizedEmail    String     @unique
  passwordHash       String
  displayName        String
  avatarFileId       String?    @db.Uuid
  locale             String     @default("vi")
  timezone           String     @default("Asia/Ho_Chi_Minh")
  mustChangePassword Boolean    @default(true)
  status             UserStatus @default(ACTIVE)
  lastLoginAt        DateTime?  @db.Timestamptz(6)
  createdAt          DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime   @updatedAt @db.Timestamptz(6)

  platformRoleAssignments   PlatformRoleAssignment[]   @relation("PlatformRoleUser")
  platformRolesAssigned     PlatformRoleAssignment[]   @relation("PlatformRoleAssigner")
  memberships               SchoolMembership[]
  schoolRolesAssigned       SchoolRoleAssignment[]     @relation("SchoolRoleAssigner")
  parentLinks               ParentStudentLink[]        @relation("ParentLinks")
  studentLinks              ParentStudentLink[]        @relation("StudentLinks")
  invitationsCreated        Invitation[]               @relation("InvitationCreator")
  sessions                  Session[]
  passwordResetTokens       PasswordResetToken[]
  filesCreated              StoredFile[]               @relation("StoredFileCreator")
  fileVersionsCreated       FileVersion[]              @relation("FileVersionCreator")
  fileLinksCreated          FileLink[]                 @relation("FileLinkCreator")
  resourcesCreated          Resource[]                 @relation("ResourceCreator")
  resourceVersionsCreated   ResourceVersion[]          @relation("ResourceVersionCreator")
  resourceTransitions       ResourceTransition[]       @relation("ResourceTransitionActor")
  categoriesCreated         ResourceCategory[]         @relation("ResourceCategoryCreator")
  tagsCreated               ResourceTag[]              @relation("ResourceTagCreator")
  resourceComments          ResourceComment[]           @relation("ResourceCommentAuthor")
  resourceReports           ResourceReport[]            @relation("ResourceReportAuthor")
  resourceBookmarks         ResourceBookmark[]
  resourceCollections       ResourceCollection[]       @relation("ResourceCollectionOwner")
  resourceAnalyticsEvents   ResourceAnalyticsEvent[]   @relation("ResourceAnalyticsActor")
  auditEvents               AuditEvent[]               @relation("AuditActor")
  emailOutboxItems          EmailOutbox[]              @relation("EmailRecipient")
  mentorProfiles            MentorProfile[]            @relation("MentorProfileUser")
  mentorProfilesVerified    MentorProfile[]            @relation("MentorProfileVerifier")
  mentorAssignmentsCreated  MentorStudentAssignment[]  @relation("MentorAssignmentCreator")
  mentorAssignments         MentorStudentAssignment[]  @relation("MentorAssignmentStudent")
  appointmentsOrganized     Appointment[]              @relation("AppointmentOrganizer")
  studentAppointments       Appointment[]              @relation("AppointmentStudent")
  mentorAppointments        Appointment[]              @relation("AppointmentMentor")
  appointmentTransitions    AppointmentTransition[]    @relation("AppointmentTransitionActor")
  appointmentWaitlist       AppointmentWaitlistEntry[]
  attendanceRecords         AppointmentAttendance[]    @relation("AttendanceUser")
  attendanceRecorded        AppointmentAttendance[]    @relation("AttendanceRecorder")
  mentoringCases            MentoringCase[]            @relation("MentoringCaseStudent")
  mentoringCasesCreated     MentoringCase[]            @relation("MentoringCaseCreator")
  mentoringGoalsCreated     MentoringGoal[]            @relation("MentoringGoalCreator")
  mentoringTasksAssigned    MentoringTask[]            @relation("MentoringTaskAssignee")
  mentoringTasksCreated     MentoringTask[]            @relation("MentoringTaskCreator")
  mentoringReferrals        MentoringReferral[]        @relation("MentoringReferralStudent")
  mentoringReferralsCreated MentoringReferral[]        @relation("MentoringReferralCreator")
  mentoringNotes            MentoringNote[]            @relation("MentoringNoteAuthor")
  sessionOutcomesCompleted  MentoringSessionOutcome[]  @relation("SessionOutcomeCompleter")
  calendarsOwned            Calendar[]                @relation("CalendarOwner")
  calendarEventsCreated     CalendarEvent[]            @relation("CalendarEventCreator")
  calendarBookings          CalendarBooking[]
  calendarAttendance        CalendarAttendance[]       @relation("CalendarAttendanceUser")
  calendarAttendanceRecorded CalendarAttendance[]     @relation("CalendarAttendanceRecorder")
  bookableResourcesCreated  BookableResource[]        @relation("BookableResourceCreator")
  workflowTemplatesCreated  WorkflowTemplate[]         @relation("WorkflowTemplateCreator")
  workflowSubmissions        WorkflowSubmission[]       @relation("WorkflowSubmissionOwner")
  workflowDecisions          WorkflowDecision[]         @relation("WorkflowDecisionActor")
  workflowHistory            WorkflowSubmissionHistory[] @relation("WorkflowHistoryActor")
}

model DemoRequest {
  id           String   @id @default(uuid()) @db.Uuid
  fullName     String
  role         String
  schoolName   String
  email        String
  phone        String?
  studentCount Int?
  module       String
  message      String?
  status       String   @default("NEW")
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([email, createdAt])
}

model PlatformRoleAssignment {
  id               String       @id @default(uuid()) @db.Uuid
  userId           String       @db.Uuid
  role             PlatformRole
  assignedByUserId String?      @db.Uuid
  createdAt        DateTime     @default(now()) @db.Timestamptz(6)

  user       User  @relation("PlatformRoleUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("PlatformRoleAssigner", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@unique([userId, role])
  @@index([role])
}

model School {
  id                String       @id @default(uuid()) @db.Uuid
  slug              String       @unique
  name              String
  shortName         String
  logoFileId        String?      @db.Uuid
  status            SchoolStatus @default(ACTIVE)
  planCode          String       @default("LOCAL")
  storageQuotaBytes BigInt       @default(1073741824)
  settingsJson      Json         @default("{}")
  createdAt         DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(6)

  memberships        SchoolMembership[]
  parentStudentLinks ParentStudentLink[]
  invitations        Invitation[]
  storedFiles        StoredFile[]
  fileLinks          FileLink[]
  resources          Resource[]
  resourceCategories ResourceCategory[]
  resourceTags       ResourceTag[]
  resourceComments   ResourceComment[]
  resourceReports    ResourceReport[]
  resourceBookmarks  ResourceBookmark[]
  resourceCollections ResourceCollection[]
  resourceAnalyticsEvents ResourceAnalyticsEvent[]
  auditEvents        AuditEvent[]
  domainOutboxEvents DomainOutboxEvent[]
  emailOutboxItems   EmailOutbox[]
  mentorProfiles     MentorProfile[]
  mentorSpecialties  MentorSpecialty[]
  mentorAssignments  MentorStudentAssignment[]
  appointmentTypes   AppointmentType[]
  appointments       Appointment[]
  mentoringCases     MentoringCase[]
  mentoringTasks     MentoringTask[]
  mentoringReferrals MentoringReferral[]
  mentoringNotes     MentoringNote[]
  calendarSources    CalendarSource[]
  calendars          Calendar[]
  bookableResources  BookableResource[]
  blockedPeriods     BlockedPeriod[]
  calendarEvents     CalendarEvent[]
  calendarBookings   CalendarBooking[]
  calendarAttendance CalendarAttendance[]
  calendarReminders  CalendarReminder[]
  workflowSubmissions WorkflowSubmission[]
  workflowTemplates  WorkflowTemplate[]

  @@index([status])
}

model SchoolMembership {
  id           String           @id @default(uuid()) @db.Uuid
  schoolId     String           @db.Uuid
  userId       String           @db.Uuid
  status       MembershipStatus @default(INVITED)
  joinedAt     DateTime?        @db.Timestamptz(6)
  leftAt       DateTime?        @db.Timestamptz(6)
  lastActiveAt DateTime?        @db.Timestamptz(6)
  createdAt    DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(6)

  school          School                 @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  user            User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  roleAssignments SchoolRoleAssignment[]

  @@unique([schoolId, userId])
  @@index([schoolId, status])
  @@index([userId, status])
}

model SchoolRoleAssignment {
  id               String     @id @default(uuid()) @db.Uuid
  membershipId     String     @db.Uuid
  role             SchoolRole
  assignedByUserId String?    @db.Uuid
  createdAt        DateTime   @default(now()) @db.Timestamptz(6)

  membership SchoolMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  assignedBy User?            @relation("SchoolRoleAssigner", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@unique([membershipId, role])
  @@index([role])
}

model ParentStudentLink {
  id                   String                  @id @default(uuid()) @db.Uuid
  schoolId             String                  @db.Uuid
  parentUserId         String                  @db.Uuid
  studentUserId        String                  @db.Uuid
  relationshipType     String
  status               ParentStudentLinkStatus @default(ACTIVE)
  startsAt             DateTime                @db.Timestamptz(6)
  endsAt               DateTime?               @db.Timestamptz(6)
  visibilityPolicyJson Json                    @default("{}")
  createdAt            DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime                @updatedAt @db.Timestamptz(6)

  school  School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  parent  User   @relation("ParentLinks", fields: [parentUserId], references: [id], onDelete: Restrict)
  student User   @relation("StudentLinks", fields: [studentUserId], references: [id], onDelete: Restrict)

  @@unique([schoolId, parentUserId, studentUserId])
  @@index([schoolId, status])
  @@index([parentUserId, status])
  @@index([studentUserId, status])
}

model Invitation {
  id              String    @id @default(uuid()) @db.Uuid
  schoolId        String    @db.Uuid
  email           String
  normalizedEmail String
  tokenHash       String    @unique
  roleHintsJson   Json      @default("[]")
  expiresAt       DateTime  @db.Timestamptz(6)
  acceptedAt      DateTime? @db.Timestamptz(6)
  revokedAt       DateTime? @db.Timestamptz(6)
  lastSentAt      DateTime  @default(now()) @db.Timestamptz(6)
  sendCount       Int       @default(1)
  createdByUserId String    @db.Uuid
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)

  school    School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  createdBy User   @relation("InvitationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([schoolId, normalizedEmail])
  @@index([schoolId, revokedAt, expiresAt])
}

model Session {
  id               String    @unique @default(uuid()) @db.Uuid
  sessionTokenHash String    @id
  userId           String    @db.Uuid
  expires          DateTime  @db.Timestamptz(6)
  revokedAt        DateTime? @db.Timestamptz(6)
  revokeReason     String?
  lastSeenAt       DateTime  @default(now()) @db.Timestamptz(6)
  userAgent        String?
  ipHash           String?
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expires])
  @@index([expires, revokedAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
}

model AuthRateLimit {
  keyHash      String    @id
  action       String
  attempts     Int       @default(0)
  windowStart  DateTime  @db.Timestamptz(6)
  blockedUntil DateTime? @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)

  @@index([action, updatedAt])
  @@index([blockedUntil])
}

model StoredFile {
  id              String           @id @default(uuid()) @db.Uuid
  schoolId        String           @db.Uuid
  storageKey      String           @unique
  originalName    String
  mimeType        String
  sizeBytes       BigInt
  sha256          String
  status          StoredFileStatus @default(PENDING)
  createdByUserId String           @db.Uuid
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)

  school    School        @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  createdBy User          @relation("StoredFileCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  versions  FileVersion[]
  links     FileLink[]

  @@unique([id, schoolId])
  @@index([schoolId, status])
  @@index([schoolId, sha256])
}

model FileVersion {
  id              String   @id @default(uuid()) @db.Uuid
  fileId          String   @db.Uuid
  versionNumber   Int
  storageKey      String   @unique
  originalName    String
  mimeType        String
  sizeBytes       BigInt
  sha256          String
  createdByUserId String   @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  file      StoredFile @relation(fields: [fileId], references: [id], onDelete: Restrict)
  createdBy User       @relation("FileVersionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([fileId, versionNumber])
  @@index([fileId, createdAt])
}

model FileLink {
  id              String   @id @default(uuid()) @db.Uuid
  schoolId        String   @db.Uuid
  fileId          String   @db.Uuid
  resourceId      String?  @db.Uuid
  entityType      String
  entityId        String   @db.Uuid
  visibility      String
  createdByUserId String   @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  school    School     @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  file      StoredFile @relation(fields: [fileId, schoolId], references: [id, schoolId], onDelete: Restrict)
  resource  Resource?  @relation(fields: [resourceId, schoolId], references: [id, schoolId], onDelete: Restrict)
  createdBy User       @relation("FileLinkCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([schoolId, entityType, entityId])
  @@index([schoolId, fileId])
  @@index([schoolId, resourceId])
}

model Resource {
  id                 String            @id @default(uuid()) @db.Uuid
  schoolId           String            @db.Uuid
  createdByUserId    String            @db.Uuid
  title              String
  slug               String
  summary            String?
  status             ResourceStatus    @default(DRAFT)
  visibility         ResourceVisibility @default(SCHOOL)
  currentVersionId   String?           @unique @db.Uuid
  publishedAt        DateTime?         @db.Timestamptz(6)
  archivedAt         DateTime?         @db.Timestamptz(6)
  createdAt          DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(6)

  school             School             @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  createdBy          User               @relation("ResourceCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  currentVersion     ResourceVersion?   @relation("ResourceCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions           ResourceVersion[]   @relation("ResourceVersions")
  transitions        ResourceTransition[]
  categories         ResourceCategory[]
  tags               ResourceTag[]
  fileLinks          FileLink[]
  comments           ResourceComment[]
  reports            ResourceReport[]
  bookmarks          ResourceBookmark[]
  collectionItems    ResourceCollectionItem[]
  analyticsEvents    ResourceAnalyticsEvent[]
  analyticsCounter   ResourceAnalyticsCounter?

  @@unique([id, schoolId])
  @@unique([schoolId, slug])
  @@index([schoolId, status, updatedAt])
  @@index([schoolId, visibility, status])
}

model ResourceVersion {
  id              String   @id @default(uuid()) @db.Uuid
  resourceId      String   @db.Uuid
  versionNumber   Int
  title           String
  summary         String?
  body            String?
  metadataJson    Json     @default("{}")
  createdByUserId String   @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  resource        Resource @relation("ResourceVersions", fields: [resourceId], references: [id], onDelete: Restrict)
  currentFor      Resource? @relation("ResourceCurrentVersion")
  createdBy       User     @relation("ResourceVersionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([resourceId, versionNumber])
  @@index([resourceId, createdAt])
}

model ResourceCategory {
  id              String   @id @default(uuid()) @db.Uuid
  schoolId        String   @db.Uuid
  name            String
  slug            String
  createdByUserId String   @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  school        School     @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  createdBy     User       @relation("ResourceCategoryCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  resources     Resource[]

  @@unique([schoolId, slug])
  @@index([schoolId, name])
}

model ResourceTag {
  id              String   @id @default(uuid()) @db.Uuid
  schoolId        String   @db.Uuid
  name            String
  slug            String
  createdByUserId String   @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  school        School     @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  createdBy     User       @relation("ResourceTagCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  resources     Resource[]

  @@unique([schoolId, slug])
  @@index([schoolId, name])
}

model ResourceTransition {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @db.Uuid
  resourceId  String   @db.Uuid
  action      String
  fromStatus  ResourceStatus?
  toStatus    ResourceStatus
  reason      String?
  actorUserId String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  actor    User     @relation("ResourceTransitionActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([schoolId, resourceId, createdAt])
  @@index([schoolId, toStatus, createdAt])
}

model ResourceComment {
  id          String        @id @default(uuid()) @db.Uuid
  schoolId    String        @db.Uuid
  resourceId  String        @db.Uuid
  authorUserId String        @db.Uuid
  body        String
  status      CommentStatus  @default(PUBLISHED)
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(6)

  school   School   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  author   User     @relation("ResourceCommentAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([schoolId, resourceId, status, createdAt])
}

model ResourceReport {
  id           String               @id @default(uuid()) @db.Uuid
  schoolId     String               @db.Uuid
  resourceId   String               @db.Uuid
  reporterUserId String              @db.Uuid
  reason       String
  status       ResourceReportStatus  @default(OPEN)
  resolution   String?
  resolvedByUserId String?          @db.Uuid
  createdAt    DateTime             @default(now()) @db.Timestamptz(6)
  resolvedAt   DateTime?            @db.Timestamptz(6)

  school   School   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  reporter User     @relation("ResourceReportAuthor", fields: [reporterUserId], references: [id], onDelete: Restrict)

  @@index([schoolId, status, createdAt])
  @@index([schoolId, resourceId, createdAt])
}

model ResourceBookmark {
  id         String   @id @default(uuid()) @db.Uuid
  schoolId   String   @db.Uuid
  resourceId String   @db.Uuid
  userId     String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  school   School   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([schoolId, resourceId, userId])
  @@index([schoolId, userId, createdAt])
}

model ResourceCollection {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @db.Uuid
  ownerUserId String   @db.Uuid
  name        String
  description String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  school School                  @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  owner  User                    @relation("ResourceCollectionOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  items  ResourceCollectionItem[]

  @@unique([schoolId, ownerUserId, name])
  @@index([schoolId, ownerUserId, updatedAt])
}

model ResourceCollectionItem {
  id           String   @id @default(uuid()) @db.Uuid
  collectionId String   @db.Uuid
  resourceId   String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  collection ResourceCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  resource   Resource           @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([collectionId, resourceId])
  @@index([resourceId])
}

model ResourceAnalyticsEvent {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @db.Uuid
  resourceId  String   @db.Uuid
  actorUserId String?  @db.Uuid
  eventType   String
  versionId   String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

