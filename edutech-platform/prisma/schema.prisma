  status           CalendarAttendanceStatus @default(SCHEDULED)
  checkedInAt      DateTime?                @db.Timestamptz(6)
  recordedByUserId String?                  @db.Uuid
  note             String?
  createdAt        DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime                 @updatedAt @db.Timestamptz(6)

  school     School        @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  event      CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user       User          @relation("CalendarAttendanceUser", fields: [userId], references: [id], onDelete: Restrict)
  recordedBy User?         @relation("CalendarAttendanceRecorder", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  @@unique([eventId, userId])
  @@index([schoolId, status])
}

model CalendarReminder {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @db.Uuid
  eventId   String   @db.Uuid
  minutesBefore Int
  sentAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  school School        @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  event  CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, minutesBefore])
  @@index([schoolId, sentAt])
}

model WorkflowTemplate {
  id          String                @id @default(uuid()) @db.Uuid
  schoolId    String                @db.Uuid
  createdById String                @db.Uuid
  name        String
  slug        String
  description String?
  status      WorkflowTemplateStatus @default(DRAFT)
  currentVersionId String?          @db.Uuid
  createdAt   DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime              @updatedAt @db.Timestamptz(6)

  school        School               @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  createdBy     User                 @relation("WorkflowTemplateCreator", fields: [createdById], references: [id], onDelete: Restrict)
  versions      WorkflowVersion[]
  submissions   WorkflowSubmission[]

  @@unique([schoolId, slug])
  @@index([schoolId, status])
}

model WorkflowVersion {
  id          String   @id @default(uuid()) @db.Uuid
  templateId  String   @db.Uuid
  version     Int
  publishedAt DateTime? @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  template WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  fields   WorkflowFieldDefinition[]
  steps    WorkflowApprovalStep[]
  submissions WorkflowSubmission[]

  @@unique([templateId, version])
}

model WorkflowFieldDefinition {
  id          String            @id @default(uuid()) @db.Uuid
  versionId   String            @db.Uuid
  key         String
  label       String
  type        WorkflowFieldType
  position    Int
  required    Boolean           @default(false)
  optionsJson Json              @default("[]")
  rulesJson   Json              @default("{}")

  version WorkflowVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, key])
  @@index([versionId, position])
}

model WorkflowApprovalStep {
  id          String   @id @default(uuid()) @db.Uuid
  versionId   String   @db.Uuid
  name        String
  position    Int
  role        SchoolRole
  deadlineHours Int?
  conditionJson Json @default("{}")
  parallelGroup Int?

  version WorkflowVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  submissions WorkflowSubmissionStep[]

  @@unique([versionId, position])
}

model WorkflowSubmission {
  id             String                   @id @default(uuid()) @db.Uuid
  schoolId       String                   @db.Uuid
  templateId     String                   @db.Uuid
  versionId      String                   @db.Uuid
  ownerUserId    String                   @db.Uuid
  status         WorkflowSubmissionStatus @default(DRAFT)
  submittedAt    DateTime?                @db.Timestamptz(6)
  createdAt      DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime                 @updatedAt @db.Timestamptz(6)

  school   School          @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  template WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  version  WorkflowVersion  @relation(fields: [versionId], references: [id], onDelete: Restrict)
  owner    User             @relation("WorkflowSubmissionOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  values   WorkflowSubmissionValue[]
  steps    WorkflowSubmissionStep[]
  decisions WorkflowDecision[]
  history  WorkflowSubmissionHistory[]

  @@index([schoolId, status, updatedAt])
  @@index([ownerUserId, status])
}

model WorkflowSubmissionValue {
  id           String   @id @default(uuid()) @db.Uuid
  submissionId String   @db.Uuid
  fieldKey     String
  valueJson    Json
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  submission WorkflowSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, fieldKey])
}

model WorkflowSubmissionStep {
  id           String            @id @default(uuid()) @db.Uuid
  submissionId String            @db.Uuid
  stepId       String            @db.Uuid
  status       WorkflowStepStatus @default(PENDING)
  assignedUserId String?         @db.Uuid
  dueAt        DateTime?         @db.Timestamptz(6)
  actedAt      DateTime?         @db.Timestamptz(6)

  submission WorkflowSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  step       WorkflowApprovalStep @relation(fields: [stepId], references: [id], onDelete: Restrict)

  @@unique([submissionId, stepId])
  @@index([assignedUserId, status, dueAt])
}

model WorkflowDecision {
  id           String               @id @default(uuid()) @db.Uuid
  submissionId String               @db.Uuid
  stepId       String               @db.Uuid
  actorUserId  String               @db.Uuid
  type         WorkflowDecisionType
  reason       String?
  createdAt    DateTime             @default(now()) @db.Timestamptz(6)

  submission WorkflowSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  actor      User               @relation("WorkflowDecisionActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([submissionId, createdAt])
}

model WorkflowSubmissionHistory {
  id           String   @id @default(uuid()) @db.Uuid
  submissionId String   @db.Uuid
  actorUserId  String   @db.Uuid
  action       String
  fromStatus   WorkflowSubmissionStatus?
  toStatus     WorkflowSubmissionStatus
  metadataJson Json     @default("{}")
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  submission WorkflowSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  actor      User               @relation("WorkflowHistoryActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([submissionId, createdAt])
}
